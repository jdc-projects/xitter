{
  "name": "xitter",
  "private": true,
  "version": "0.0.0",
  "description": "Twitter/X-style demo app - microservices monorepo",
  "license": "Unlicense",
  "packageManager": "npm@11.19.0",
  "engines": {
    "node": ">=24"
  },
  "workspaces": [
    "apps/*",
    "apps/services/*",
    "apps/workers/*",
    "packages/*"
  ],
  "scripts": {
    "db:push": "turbo run db:push",
    "db:push:services": "turbo run db:push --filter=./apps/services/*",
    "db:migrate": "turbo run migrate",
    "db:migrate:deploy": "turbo run migrate:deploy",
    "mutate": "turbo run mutate",
    "mutate:affected": "turbo run mutate --filter=...[origin/dev]",
    "build": "turbo run build",
    "build:packages": "turbo run build --filter=./packages/*",
    "build:apps": "turbo run build --filter=./apps/*",
    "dev": "turbo run dev",
    "start": "turbo run start",
    "start:apps": "turbo run start --filter=web --filter=cms --filter=admin --filter=@xitter/service-social --filter=@xitter/service-posts --filter=@xitter/service-media --filter=@xitter/service-feed --filter=@xitter/service-search",
    "start:workers": "turbo run start --filter=@xitter/worker-fanout --filter=@xitter/worker-media-process --filter=@xitter/worker-search-index",
    "check": "npm run format:check && npm run audit && npm run build:packages && turbo run lint typecheck test build",
    "check:repo": "npm run check && npm run lint:repo",
    "check:mutation": "npm run mutate:affected",
    "check:load": "npm run test:load",
    "check:all": "npm run check:repo && npm run check:mutation && npm run test:web && npm run test:e2e && npm run check:load",
    "clean": "tsx packages/scripts/src/clean.ts",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "turbo run typecheck",
    "lint": "turbo run lint",
    "lint:repo": "npm run docs:diagrams && fallow audit --base ${FALLOW_BASE:-origin/dev} --dead-code-baseline .fallow/dead-code.json --health-baseline .fallow/health.json --dupes-baseline .fallow/dupes.json && react-doctor -y --no-supply-chain",
    "test": "turbo run test",
    "test:watch": "turbo run test:watch",
    "test:unit": "turbo run test",
    "test:web": "playwright test -c tests/playwright/web",
    "test:e2e": "playwright test -c tests/playwright/e2e",
    "test:a11y": "playwright test -c tests/playwright/e2e --project=a11y",
    "test:load": "artillery run tests/artillery/feed-flow.yml",
    "test:api": "npm test --prefix bruno/xitter",
    "deps:up": "tsx packages/scripts/src/docker.ts up",
    "deps:down": "tsx packages/scripts/src/docker.ts down",
    "deps:status": "tsx packages/scripts/src/docker.ts status",
    "topics:create": "tsx packages/scripts/src/topics.ts create",
    "keycloak:init": "tsx packages/scripts/src/keycloak.ts init",
    "bootstrap": "tsx packages/scripts/src/bootstrap.ts",
    "reset": "tsx packages/scripts/src/reset.ts",
    "reset:reseed": "tsx packages/scripts/src/reset.ts --seed",
    "reset:live": "tsx packages/scripts/src/reset-flow.ts",
    "seed": "tsx packages/scripts/src/seed.ts",
    "content:apply": "tsx packages/scripts/src/content.ts apply",
    "content:export": "tsx packages/scripts/src/content.ts export",
    "openapi:gen": "turbo run openapi:gen && tsx packages/scripts/src/openapi.ts collect",
    "env:print": "tsx packages/scripts/src/env.ts print",
    "predeps:up": "npm run build:packages",
    "predeps:down": "npm run build:packages",
    "predeps:status": "npm run build:packages",
    "gates": "turbo run lint typecheck test build",
    "test:install": "playwright install --with-deps chromium",
    "docs:diagrams": "tsx packages/scripts/src/diagrams.ts",
    "audit": "npm audit --audit-level=high"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@mermaid-js/mermaid-cli": "^11.16.0",
    "@playwright/test": "^1",
    "@types/node": "^26",
    "@usebruno/cli": "^4",
    "@xitter/config": "*",
    "artillery": "^2",
    "eslint": "^9",
    "fallow": "^3",
    "playwright-core": "^1.62.1",
    "prettier": "^3",
    "react-doctor": "^0.9",
    "tsx": "^4",
    "turbo": "^2",
    "typescript": "^6"
  },
  "puppeteer": {
    "skipDownload": true
  },
  "overrides": {
    "axios": "^1.19",
    "dompurify": "^3.4.13",
    "form-data": "^4",
    "nanoid": "^5",
    "path-to-regexp": "^8.4.2",
    "qs": "^6.15.3"
  },
  "allowScripts": {
    "esbuild@0.18.20": true,
    "esbuild@0.25.12": true,
    "esbuild@0.28.2": true,
    "@playwright/browser-chromium@1.62.1": true,
    "@prisma/engines@7.9.1": true,
    "cpu-features@0.0.10": true,
    "prisma@7.9.1": true,
    "protobufjs@7.6.5": true,
    "puppeteer@25.7.0": true,
    "ssh2@1.17.0": true,
    "unix-dgram@2.0.7": true,
    "unrs-resolver@1.12.2": true,
    "fsevents@2.3.3": true,
    "fsevents@2.3.2": true
  }
}
