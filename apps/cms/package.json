{
  "name": "cms",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "dev": "tsx scripts/serve.ts dev",
    "build": "payload generate:importmap && payload generate:types && next build --turbopack && node scripts/bundle-migrations.mjs",
    "start": "tsx scripts/serve.ts start",
    "generate": "payload generate:importmap && payload generate:types",
    "db:push": "tsx scripts/db-push.ts",
    "migrate": "payload migrate",
    "migrate:create": "payload migrate:create",
    "migrate:deploy": "node .next/migrate/migrate.mjs",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@payloadcms/db-postgres": "^3",
    "@payloadcms/live-preview-react": "^3",
    "@payloadcms/next": "^3",
    "@payloadcms/richtext-lexical": "^3",
    "@xitter/auth": "*",
    "@xitter/config": "*",
    "@xitter/observability": "*",
    "next": "^16",
    "openid-client": "^6.8.5",
    "payload": "^3",
    "react": "^19",
    "react-dom": "^19",
    "sharp": "^0.35",
    "zod": "^4"
  },
  "devDependencies": {
    "@types/node": "^26",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@xitter/eslint-config": "*",
    "@xitter/tsconfig": "*",
    "esbuild": "^0.28",
    "tsx": "^4",
    "typescript": "^6",
    "vitest": "^4"
  },
  "type": "module"
}
