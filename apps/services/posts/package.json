{
  "name": "@xitter/service-posts",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "dev": "tsx watch src/main.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/main.js",
    "generate": "prisma generate",
    "migrate": "prisma migrate dev",
    "migrate:deploy": "prisma migrate deploy",
    "db:push": "prisma db push",
    "lint": "eslint .",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "openapi:gen": "tsx src/openapi.gen.ts",
    "mutate": "stryker run"
  },
  "dependencies": {
    "@fastify/helmet": "^13.1",
    "@fastify/multipart": "^10.1",
    "@nestjs/common": "^11.2",
    "@nestjs/config": "^4.0",
    "@nestjs/core": "^11.2",
    "@nestjs/platform-fastify": "^11.2",
    "@nestjs/swagger": "^11.4",
    "@nestjs/terminus": "^11.1",
    "@nestjs/websockets": "^11.2",
    "@prisma/adapter-pg": "^7.9",
    "@xitter/api-contracts": "*",
    "@xitter/auth": "*",
    "@xitter/config": "*",
    "@xitter/eslint-config": "*",
    "@xitter/events": "*",
    "@xitter/observability": "*",
    "@xitter/tsconfig": "*",
    "fastify": "^5.12",
    "fastify-metrics": "^11",
    "jose": "^6.2",
    "kafkajs": "^2.2",
    "pg": "^8.23",
    "pino": "^10.3",
    "prom-client": "^15.1",
    "reflect-metadata": "^0.2",
    "rxjs": "^7.8",
    "ws": "^8.21",
    "zod": "^4.4"
  },
  "devDependencies": {
    "@nestjs/platform-ws": "^11.2",
    "@nestjs/testing": "^11.2",
    "@stryker-mutator/core": "^10.0",
    "@stryker-mutator/vitest-runner": "^10.0",
    "@testcontainers/postgresql": "^12.1",
    "@types/node": "^26.2",
    "@types/ws": "^8.18",
    "@xitter/testing": "*",
    "prisma": "^7.9",
    "tsx": "^4.23",
    "typescript": "^6.0",
    "vitest": "^4.1"
  }
}
