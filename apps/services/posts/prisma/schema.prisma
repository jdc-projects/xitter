generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  runtime      = "nodejs"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

model Post {
  id         String    @id @default(uuid())
  authorId   String
  text       String
  mediaIds   String[]  @default([])
  replyToId  String?
  repostOfId String?
  createdAt  DateTime  @default(now())
  deletedAt  DateTime?

  interactions Interaction[]
  replies      Post[]         @relation("replies")
  parent       Post?          @relation("replies", fields: [replyToId], references: [id])

  // Counts read-model (spec data/01): initialised 0 at creation. Replies are
  // maintained here by the posts service; likes/reposts by #8's interactions.
  replyCount Int @default(0)
  likeCount  Int @default(0)
  repostCount Int @default(0)

  @@index([authorId, createdAt])
  @@index([replyToId])
}

model Interaction {
  id        String   @id @default(uuid())
  kind      String // like | bookmark | repost
  postId    String
  userId    String
  createdAt DateTime @default(now())

  post Post @relation(fields: [postId], references: [id], onDelete: Cascade)

  @@unique([kind, postId, userId])
  @@index([userId, kind])
}
