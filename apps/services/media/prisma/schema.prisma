generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  runtime      = "nodejs"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

model MediaAsset {
  id         String    @id @default(uuid())
  ownerId    String
  status     String // pending | ready | failed
  objectKey  String
  mimeType   String
  bytes      Int
  variants   Json     @default("[]")
  attempts   Int      @default(0)
  uploadedAt DateTime?
  // Author-supplied alt text (#133), set when the owning post is created;
  // null until then (readers fall back to a generic description).
  altText    String?
  createdAt  DateTime  @default(now())

  @@index([ownerId])
  @@index([status])
}

// Moderation accountability (T10): who deleted which asset, when. Owned by
// this service because the action targets its rows + objects.
model AuditLog {
  id        String   @id @default(uuid())
  actorId   String // admin principal sub (user uuid or service-account id)
  actorName  String // preferred_username / client id for the panel display
  action    String // media.delete
  targetId  String // media id
  detail    Json?
  createdAt DateTime @default(now())

  @@index([createdAt])
}
