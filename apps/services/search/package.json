{
  "name": "@xitter/service-search",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "dev": "tsx watch src/main.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/main.js",
    "generate": "prisma generate",
    "migrate": "prisma migrate dev",
    "migrate:deploy": "prisma migrate deploy",
    "db:push": "prisma db push",
    "lint": "eslint .",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "openapi:gen": "tsx openapi.gen.mts",
    "mutate": "stryker run stryker.config.ts"
  },
  "dependencies": {
    "@fastify/helmet": "^13",
    "@nestjs/common": "^11",
    "@nestjs/config": "^4",
    "@nestjs/core": "^11",
    "@nestjs/platform-fastify": "^11",
    "@nestjs/terminus": "^11",
    "@prisma/adapter-pg": "^7",
    "@prisma/client": "^7",
    "@xitter/api-contracts": "*",
    "@xitter/auth": "*",
    "@xitter/auth-nest": "*",
    "@xitter/config": "*",
    "@xitter/events": "*",
    "@xitter/health": "*",
    "@xitter/observability": "*",
    "fastify": "^5",
    "pg": "^8",
    "reflect-metadata": "^0.2",
    "rxjs": "^7",
    "zod": "^4"
  },
  "devDependencies": {
    "@asteasolutions/zod-to-openapi": "^9",
    "@nestjs/testing": "^11",
    "@stryker-mutator/core": "^10",
    "@stryker-mutator/vitest-runner": "^10",
    "@testcontainers/postgresql": "^12",
    "@types/node": "^26",
    "@xitter/eslint-config": "*",
    "@xitter/testing": "*",
    "@xitter/tsconfig": "*",
    "prisma": "^7",
    "tsx": "^4",
    "typescript": "^6",
    "vitest": "^4"
  }
}
