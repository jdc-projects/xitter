generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  runtime      = "nodejs"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

/// Materialised home-feed entry written by the fanout worker (ADR 0003).
/// ids + ordering columns only; post/author payloads hydrate on read.
model FeedEntry {
  id            String   @id @default(uuid())
  userId        String
  postId        String
  authorId      String
  reason        String // post | repost
  repostedById  String?
  postCreatedAt DateTime
  insertedAt    DateTime @default(now())

  // Natural key (spec 04 idempotency): event replays converge. repostedById
  // is deliberately OUT of the key - Postgres treats NULLs as distinct in
  // unique indexes, so a nullable column would defeat the constraint for
  // reason = 'post' rows. #8 refines the repost key when reposts land.
  @@unique([userId, postId, reason])
  @@index([userId, postCreatedAt(sort: Desc), id(sort: Desc)])
  @@index([postId])
  @@index([userId, authorId])
}
