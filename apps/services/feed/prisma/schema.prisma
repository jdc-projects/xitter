generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  runtime      = "nodejs"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

/// Materialised home-feed entry written by the fanout worker (ADR 0003).
/// ids + ordering columns only; post/author payloads hydrate on read.
model FeedEntry {
  id            String   @id @default(uuid())
  userId        String
  postId        String
  authorId      String
  reason        String // post | repost
  repostedById  String?
  /// Stable identity of the source event for this row: `post:{postId}` or
  /// `repost:{postId}:{repostedById}`. A post reposted by two users must fan
  /// out to TWO distinct entries per feed - (userId, postId) alone would
  /// collide. Derived upstream (api-contracts feedEntryKey) so every writer
  /// computes the same string; NOT NULL and always set (no NULL-distinct
  /// unique-index hole).
  entryKey      String
  postCreatedAt DateTime
  insertedAt    DateTime @default(now())

  // Natural key (spec 04 idempotency): event replays converge on the
  // entryKey. See #25's PR + spec 01: the earlier key (userId, postId,
  // reason) broke once reposts landed - two different reposters of the same
  // post collided and the second entry was silently dropped (skipDuplicates).
  @@unique([userId, entryKey])
  @@index([userId, postCreatedAt(sort: Desc), id(sort: Desc)])
  @@index([postId])
  @@index([userId, authorId])
}

/// Durable resume cursor for the fanout worker (#149): one row per
/// (consumer, topic-partition), the feed-owned twin of search's
/// SearchCheckpoint. Fanout materialises feed's store, so feed owns its
/// worker's resume positions: a restart outside a reset resumes exactly
/// after the last processed event instead of seeking to the log end and
/// permanently skipping the downtime gap. Wiped by the nightly reseed
/// (checkpoints are disposable - the reset gate re-seeks to the log end).
model FeedCheckpoint {
  id             String    @id @default(uuid())
  consumerKey    String
  topicPartition String
  lastOffset     BigInt
  lastEventId    String?
  lastEventAt    DateTime?
  updatedAt      DateTime  @updatedAt

  @@unique([consumerKey, topicPartition])
}
