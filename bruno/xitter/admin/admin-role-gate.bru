meta {
  name: Admin endpoints (role gate)
  seq: 2
}

docs {
  The negative half of the admin pair: a demo-realm user token is not an
  admin principal (admin routes accept the admin realm's user tokens or
  the svc-admin machine client - the shared guard owns that decision), so
  the internal admin endpoints must refuse it with 401: for these routes
  the demo token is simply not an authenticated caller.
}

script:pre-request {
  const form =
    "grant_type=password&client_id=web" +
    "&username=" +
    encodeURIComponent(bru.getEnvVar("username") || "demo1") +
    "&password=" +
    encodeURIComponent(bru.getEnvVar("password") || "DemoPass123!");
  const res = await bru.sendRequest({
    method: "POST",
    url: `${bru.getEnvVar("keycloak")}/realms/${bru.getEnvVar("realm")}/protocol/openid-connect/token`,
    headers: { "content-type": "application/x-www-form-urlencoded" },
    data: form,
  });
  // sendRequest returns one of string / ArrayBuffer / parsed object
  // depending on transport - decode all three or access_token reads
  // undefined off a Buffer and the bearer becomes literally "undefined"
  // (observed: the gate then 401s for the wrong reason and the run is
  // indistinguishable from a broken login).
  const raw =
    typeof res.data === "string"
      ? res.data
      : res.data && typeof res.data === "object" && "byteLength" in res.data
        ? new TextDecoder().decode(res.data)
        : typeof res.data === "object" && res.data !== null
          ? JSON.stringify(res.data)
          : String(res.data ?? "");
  bru.setEnvVar("token", JSON.parse(raw).access_token);
}

get {
  url: {{seedBase}}/api/posts/internal/admin/posts
  body: none
  auth: bearer
}

auth:bearer {
  token: {{token}}
}

assert {
  res.status: 401
}
