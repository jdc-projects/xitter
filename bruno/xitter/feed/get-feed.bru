meta {
  name: Get feed
  seq: 5
}

docs {
  Materialised home timeline (T6). Deterministic standalone: the
  pre-request script obtains a password-grant token like create-post, so
  this passes without a prior request having set {{token}}.
}

script:pre-request {
  const form =
    "grant_type=password&client_id=web" +
    "&username=" +
    encodeURIComponent(bru.getEnvVar("username") || "demo1") +
    "&password=" +
    encodeURIComponent(bru.getEnvVar("password") || "DemoPass123!");
  const res = await bru.sendRequest({
    method: "POST",
    url: `${bru.getEnvVar("keycloak")}/realms/${bru.getEnvVar("realm")}/protocol/openid-connect/token`,
    headers: { "content-type": "application/x-www-form-urlencoded" },
    data: form,
  });
  const json = typeof res.data === "string" ? JSON.parse(res.data) : res.data;
  bru.setEnvVar("token", json.access_token);
}

get {
  url: {{seedBase}}/api/feed/v1/feed?limit=20
  body: none
  auth: bearer
}

auth:bearer {
  token: {{token}}
}

assert {
  res.status: 200
}

tests {
  expect(res.body.items).to.be.an("array");
  for (const item of res.body.items) {
    expect(item.post).to.be.an("object");
    expect(item.author).to.be.an("object");
    expect(item.post.deletedAt).to.be.null;
  }
}
