meta {
  name: Follow user
  seq: 3
}

docs {
  Follows demo2 as demo1 (env username). Deterministic without seeding
  (seeding is a later ticket): both profiles are bootstrapped first - the
  caller's own via an upsert, the target's with a second token - then the
  follow is issued against the target's real Keycloak subject id. Idempotent:
  following an already-followed profile still returns 204.
}

vars:pre-request {
  targetUsername: demo2
}

script:pre-request {
  const tokenUrl = `${bru.getEnvVar("keycloak")}/realms/${bru.getEnvVar("realm")}/protocol/openid-connect/token`;

  async function login(username) {
    const form =
      "grant_type=password&client_id=web" +
      "&username=" + encodeURIComponent(username) +
      "&password=" + encodeURIComponent(bru.getEnvVar("password") || "DemoPass123!");
    const res = await bru.sendRequest({
      method: "POST",
      url: tokenUrl,
      headers: { "content-type": "application/x-www-form-urlencoded" },
      data: form,
    });
    const raw =
      typeof res.data === "string"
        ? res.data
        : res.data && typeof res.data === "object" && "byteLength" in res.data
          ? new TextDecoder().decode(res.data)
          : typeof res.data === "object" && res.data !== null
            ? JSON.stringify(res.data)
            : String(res.data ?? "");
    return JSON.parse(raw).access_token;
  }

  function subjectOf(accessToken) {
    return JSON.parse(Buffer.from(accessToken.split(".")[1], "base64").toString()).sub;
  }

  // Target first: bootstrap demo2's profile so the follow has somewhere to land.
  const targetToken = await login(bru.getVar("targetUsername") || "demo2");
  const targetId = subjectOf(targetToken);
  await bru.sendRequest({
    method: "POST",
    url: `${bru.getEnvVar("seedBase")}/api/social/v1/profiles/${targetId}`,
    headers: {
      "content-type": "application/json",
      authorization: `Bearer ${targetToken}`,
    },
    data: {},
  });

  // Then act as the caller (default demo1).
  const callerToken = await login(bru.getEnvVar("username") || "demo1");
  bru.setEnvVar("token", callerToken);
  bru.setVar("targetUserId", targetId);
}

post {
  url: {{seedBase}}/api/social/v1/profiles/{{targetUserId}}/follow
  body: none
  auth: bearer
}

auth:bearer {
  token: {{token}}
}

assert {
  res.status: 204
}
