meta {
  name: Edge wiring (unauth)
  seq: 1
}

docs {
  Asserts unauthenticated requests are rejected with 401, proving routing +
  realm wiring: in dev the edge's oidc-api middleware rejects before the
  service; locally the social service's own JWT guard does. Service-level
  health is validated by port-forward (runbook 02, step 5).
}

get {
  url: {{seedBase}}/api/social/v1/profiles/edge-wiring-check
  body: none
  auth: none
}

assert {
  res.status: 401
}
