meta {
  name: Search posts
  seq: 6
}

get {
  url: {{seedBase}}/api/search/v1/posts?q=hello
  body: none
  auth: bearer
}

auth:bearer {
  token: {{token}}
}

assert {
  res.status: 200
  res.body.items !== undefined
  res.body.nextCursor !== undefined
}

script:post-response {
  // Page items are hydrated (post + author) per spec 03 - the search
  // contract mirrors the feed page shape.
  const item = res.body.items && res.body.items[0];
  if (item) {
    bru.test('items are hydrated post+author pairs', () => {
      bru.expect(item.post).to.be.an('object');
      bru.expect(item.post.id).to.be.a('string');
      bru.expect(item.author).to.be.an('object');
      bru.expect(item.author.username).to.be.a('string');
    });
  } else {
    bru.test('empty page is a valid result', () => {
      bru.expect(res.body.items).to.be.an('array');
    });
  }
}
