{
  "name": "@xitter/eslint-config",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": ["dist"],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "lint": "eslint .",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "typescript-eslint": "^8.67"
  },
  "peerDependencies": {
    "eslint": "^10"
  },
  "devDependencies": {
    "eslint": "^10",
    "@xitter/tsconfig": "*"
  }
}
