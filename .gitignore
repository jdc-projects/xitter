# Dependencies
node_modules/

# Builds
dist/
.next/
out/
build/
.turbo/
*.tsbuildinfo
**/*.js.map
**/*.d.ts.map

# Generated Prisma clients (prisma-client generator output)
**/src/generated/prisma/

# Generated by Payload (payload generate:importmap / generate:types)
apps/cms/src/app/(payload)/admin/importMap.js
apps/cms/src/payload-types.ts

# Coverage / test artifacts
coverage/
.playwright/
test-results/
playwright-report/
artillery-report/
.stryker-tmp/
reports/
mutation/
tests/playwright/*/report/

# Generated per-service OpenAPI artifacts (collected into docs/specs/architecture/openapi)
apps/**/openapi.json

# Env - examples are committed, real env files are not
.env
.env.*
!.env.example

# Cluster kubeconfig (homelab credentials) - placed per the deploy runbook
infra/cluster.yml

# OpenTofu working directories (providers, module caches, lockfiles per env)
.terraform/
.terraform.lock.hcl

# Local state
.DS_Store
*.log

# Bruno - local collection state only
bruno/**/*.local.bru

.fallow/cache*
.fallow/graph-cache.bin
.fallow/churn.bin
