{
  "$schema": "https://turborepo.com/schema.json",
  "ui": "stream",
  "globalEnv": ["NODE_ENV", "XITTER_ENV", "XITTER_PORT_OFFSET", "CI"],
  "tasks": {
    "build": {
      "dependsOn": ["^build", "generate"],
      "inputs": ["$TURBO_DEFAULT$", "!**/*.test.ts", "!tests/**"],
      "outputs": [
        "dist/**",
        ".next/**",
        "!.next/cache/**",
        "next-env.d.ts",
        "public/build/**",
        "*.tsbuildinfo"
      ]
    },
    "generate": {
      "inputs": [
        "prisma/**",
        "prisma.config.ts",
        "src/payload.config.ts",
        "src/collections/**",
        "package.json"
      ],
      "outputs": [
        "src/generated/prisma/**",
        "src/payload-types.ts",
        "src/app/(payload)/admin/importMap.js"
      ]
    },
    "dev": {
      "dependsOn": ["^build"],
      "cache": false,
      "persistent": true
    },
    "start": {
      "dependsOn": ["build"],
      "cache": false,
      "persistent": true
    },
    "lint": {
      "dependsOn": ["^build"]
    },
    "typecheck": {
      "dependsOn": ["^build", "generate"]
    },
    "test": {
      "dependsOn": ["^build", "generate"]
    },
    "test:watch": {
      "cache": false,
      "persistent": true
    },
    "migrate": {
      "cache": false,
      "dependsOn": ["^build"]
    },
    "migrate:deploy": {
      "cache": false,
      "dependsOn": ["^build"]
    },
    "openapi:gen": {
      "dependsOn": ["^build"],
      "outputs": ["openapi.json"]
    },
    "mutate": {
      "cache": false,
      "dependsOn": ["^build"]
    },
    "format": {
      "cache": false
    },
    "format:check": {
      "cache": false
    },
    "db:push": {
      "cache": false,
      "dependsOn": ["^build"]
    }
  }
}
