{
  "openapi": "3.0.3",
  "info": {
    "title": "xitter feed API",
    "description": "Materialised home feeds and real-time feed updates.",
    "version": "v1"
  },
  "servers": [
    {
      "url": "/api/feed/v1"
    }
  ],
  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT"
      },
      "serviceToken": {
        "type": "http",
        "scheme": "bearer",
        "description": "Client-credentials service token (audience = svc-feed)."
      }
    },
    "schemas": {
      "Error": {
        "type": "object",
        "properties": {
          "error": {
            "type": "object",
            "properties": {
              "code": {
                "type": "string"
              },
              "message": {
                "type": "string"
              },
              "details": {
                "type": "object",
                "additionalProperties": {
                  "nullable": true
                }
              }
            },
            "required": ["code", "message"]
          }
        },
        "required": ["error"]
      },
      "UpsertFeedEntriesRequest": {
        "type": "object",
        "properties": {
          "entries": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "userId": {
                  "type": "string",
                  "format": "uuid",
                  "example": "b1c2d3e4-0000-4000-8000-000000000001"
                },
                "postId": {
                  "type": "string",
                  "format": "uuid",
                  "example": "b1c2d3e4-0000-4000-8000-000000000002"
                },
                "authorId": {
                  "type": "string",
                  "format": "uuid",
                  "example": "b1c2d3e4-0000-4000-8000-000000000001"
                },
                "reason": {
                  "type": "string",
                  "enum": ["post", "repost"]
                },
                "repostedById": {
                  "type": "string",
                  "nullable": true,
                  "format": "uuid",
                  "default": null,
                  "example": "b1c2d3e4-0000-4000-8000-000000000001"
                },
                "postCreatedAt": {
                  "type": "string",
                  "format": "date-time"
                }
              },
              "required": ["userId", "postId", "authorId", "reason", "postCreatedAt"]
            },
            "minItems": 1,
            "maxItems": 1000
          }
        },
        "required": ["entries"],
        "additionalProperties": false
      },
      "ResetStatus": {
        "type": "object",
        "nullable": true,
        "properties": {
          "job": {
            "type": "string"
          },
          "startedAt": {
            "type": "string",
            "format": "date-time"
          },
          "finishedAt": {
            "type": "string",
            "format": "date-time"
          },
          "durationMs": {
            "type": "integer",
            "minimum": 0
          },
          "success": {
            "type": "boolean"
          },
          "reseeded": {
            "type": "boolean"
          },
          "fingerprint": {
            "type": "string",
            "nullable": true
          },
          "steps": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ResetStepStatus"
            }
          }
        },
        "required": [
          "job",
          "startedAt",
          "finishedAt",
          "durationMs",
          "success",
          "reseeded",
          "fingerprint",
          "steps"
        ],
        "additionalProperties": false
      },
      "ResetStepStatus": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string"
          },
          "ok": {
            "type": "boolean"
          },
          "durationMs": {
            "type": "integer",
            "minimum": 0
          }
        },
        "required": ["name", "ok", "durationMs"],
        "additionalProperties": false
      }
    },
    "parameters": {}
  },
  "paths": {
    "/feed": {
      "get": {
        "tags": ["feed"],
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "description": "Materialised home timeline (followed + own posts and reposts, newest first), hydrated server-side; deleted posts and blocked authors are excluded. Repost entries carry the reposter profile (`repostedBy`) for attribution.",
        "parameters": [
          {
            "schema": {
              "type": "string",
              "minLength": 1
            },
            "required": false,
            "name": "cursor",
            "in": "query"
          },
          {
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 50,
              "default": 20
            },
            "required": false,
            "name": "limit",
            "in": "query"
          }
        ],
        "responses": {
          "200": {
            "description": "Feed page",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "items": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "properties": {
                          "post": {
                            "type": "object",
                            "properties": {
                              "id": {
                                "type": "string",
                                "format": "uuid",
                                "example": "b1c2d3e4-0000-4000-8000-000000000002"
                              },
                              "authorId": {
                                "type": "string",
                                "format": "uuid",
                                "example": "b1c2d3e4-0000-4000-8000-000000000001"
                              },
                              "text": {
                                "type": "string",
                                "minLength": 1,
                                "maxLength": 512
                              },
                              "media": {
                                "type": "array",
                                "items": {
                                  "type": "object",
                                  "properties": {
                                    "id": {
                                      "type": "string",
                                      "format": "uuid"
                                    },
                                    "ownerId": {
                                      "type": "string",
                                      "format": "uuid",
                                      "example": "b1c2d3e4-0000-4000-8000-000000000001"
                                    },
                                    "status": {
                                      "type": "string",
                                      "enum": ["pending", "ready", "failed"]
                                    },
                                    "variants": {
                                      "type": "array",
                                      "items": {
                                        "type": "object",
                                        "properties": {
                                          "kind": {
                                            "type": "string",
                                            "enum": ["original", "thumb"]
                                          },
                                          "objectKey": {
                                            "type": "string",
                                            "minLength": 1
                                          },
                                          "mimeType": {
                                            "type": "string",
                                            "minLength": 1
                                          },
                                          "bytes": {
                                            "type": "integer",
                                            "minimum": 0,
                                            "exclusiveMinimum": true
                                          },
                                          "width": {
                                            "type": "integer",
                                            "nullable": true,
                                            "minimum": 0,
                                            "exclusiveMinimum": true
                                          },
                                          "height": {
                                            "type": "integer",
                                            "nullable": true,
                                            "minimum": 0,
                                            "exclusiveMinimum": true
                                          },
                                          "url": {
                                            "type": "string",
                                            "minLength": 1
                                          }
                                        },
                                        "required": [
                                          "kind",
                                          "objectKey",
                                          "mimeType",
                                          "bytes",
                                          "width",
                                          "height",
                                          "url"
                                        ]
                                      }
                                    },
                                    "createdAt": {
                                      "type": "string",
                                      "format": "date-time"
                                    }
                                  },
                                  "required": ["id", "ownerId", "status", "variants", "createdAt"]
                                }
                              },
                              "replyToId": {
                                "type": "string",
                                "nullable": true,
                                "format": "uuid",
                                "example": "b1c2d3e4-0000-4000-8000-000000000002"
                              },
                              "repostOfId": {
                                "type": "string",
                                "nullable": true,
                                "format": "uuid",
                                "example": "b1c2d3e4-0000-4000-8000-000000000002"
                              },
                              "counts": {
                                "type": "object",
                                "properties": {
                                  "replies": {
                                    "type": "integer",
                                    "minimum": 0
                                  },
                                  "likes": {
                                    "type": "integer",
                                    "minimum": 0
                                  },
                                  "reposts": {
                                    "type": "integer",
                                    "minimum": 0
                                  }
                                },
                                "required": ["replies", "likes", "reposts"]
                              },
                              "createdAt": {
                                "type": "string",
                                "format": "date-time"
                              },
                              "deletedAt": {
                                "type": "string",
                                "nullable": true,
                                "format": "date-time"
                              }
                            },
                            "required": [
                              "id",
                              "authorId",
                              "text",
                              "media",
                              "replyToId",
                              "repostOfId",
                              "counts",
                              "createdAt",
                              "deletedAt"
                            ]
                          },
                          "author": {
                            "type": "object",
                            "properties": {
                              "id": {
                                "type": "string",
                                "format": "uuid",
                                "example": "b1c2d3e4-0000-4000-8000-000000000001"
                              },
                              "username": {
                                "type": "string",
                                "minLength": 3,
                                "maxLength": 20,
                                "pattern": "^[a-z0-9_]+$"
                              },
                              "displayName": {
                                "type": "string",
                                "minLength": 1,
                                "maxLength": 50
                              },
                              "bio": {
                                "type": "string",
                                "nullable": true,
                                "maxLength": 200
                              },
                              "createdAt": {
                                "type": "string",
                                "format": "date-time"
                              }
                            },
                            "required": ["id", "username", "displayName", "bio", "createdAt"]
                          },
                          "reason": {
                            "type": "string",
                            "enum": ["post", "repost"]
                          },
                          "repostedBy": {
                            "type": "object",
                            "nullable": true,
                            "properties": {
                              "id": {
                                "type": "string",
                                "format": "uuid",
                                "example": "b1c2d3e4-0000-4000-8000-000000000001"
                              },
                              "username": {
                                "type": "string",
                                "minLength": 3,
                                "maxLength": 20,
                                "pattern": "^[a-z0-9_]+$"
                              },
                              "displayName": {
                                "type": "string",
                                "minLength": 1,
                                "maxLength": 50
                              },
                              "bio": {
                                "type": "string",
                                "nullable": true,
                                "maxLength": 200
                              },
                              "createdAt": {
                                "type": "string",
                                "format": "date-time"
                              }
                            },
                            "required": ["id", "username", "displayName", "bio", "createdAt"]
                          }
                        },
                        "required": ["post", "author", "reason", "repostedBy"]
                      }
                    },
                    "nextCursor": {
                      "type": "string",
                      "nullable": true
                    }
                  },
                  "required": ["items", "nextCursor"]
                }
              }
            }
          },
          "400": {
            "description": "Invalid cursor",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/ws": {
      "get": {
        "tags": ["feed"],
        "description": "WebSocket endpoint (wss upgrade only): `wss://{host}/api/feed/v1/ws?token={accessToken}`. Server-to-client notifications only - `{ \"type\": \"feed.new-items\", \"count\": n }`; clients refetch `GET /v1/feed`.",
        "responses": {
          "400": {
            "description": "Plain HTTP GET: connect via wss upgrade instead",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/internal/feed/entries": {
      "post": {
        "tags": ["internal"],
        "security": [
          {
            "serviceToken": []
          }
        ],
        "description": "Bulk idempotent entry upsert (fanout worker); conflicts on the natural key (userId, entryKey - derived per source: `post:{postId}` / `repost:{postId}:{repostedById}`) are skipped. Affected users get a ws notification.",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/UpsertFeedEntriesRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Rows actually inserted (replays report 0)",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "inserted": {
                      "type": "integer",
                      "minimum": 0
                    }
                  },
                  "required": ["inserted"],
                  "additionalProperties": false
                }
              }
            }
          },
          "400": {
            "description": "Validation error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/internal/feed/posts/{postId}/entries": {
      "delete": {
        "tags": ["internal"],
        "security": [
          {
            "serviceToken": []
          }
        ],
        "description": "Post deleted: entries for the post leave every feed (fanout worker).",
        "parameters": [
          {
            "schema": {
              "type": "string",
              "format": "uuid",
              "example": "b1c2d3e4-0000-4000-8000-000000000002"
            },
            "required": true,
            "name": "postId",
            "in": "path"
          }
        ],
        "responses": {
          "200": {
            "description": "Rows deleted",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "deleted": {
                      "type": "integer"
                    }
                  },
                  "required": ["deleted"]
                }
              }
            }
          }
        }
      }
    },
    "/internal/feed/posts/{postId}/reposts/{repostedById}": {
      "delete": {
        "tags": ["internal"],
        "security": [
          {
            "serviceToken": []
          }
        ],
        "description": "Repost undone (#8): only that reposter’s repost entries for the post go - the post’s own entries and other reposters’ stay.",
        "parameters": [
          {
            "schema": {
              "type": "string",
              "format": "uuid",
              "example": "b1c2d3e4-0000-4000-8000-000000000002"
            },
            "required": true,
            "name": "postId",
            "in": "path"
          },
          {
            "schema": {
              "type": "string",
              "format": "uuid",
              "example": "b1c2d3e4-0000-4000-8000-000000000001"
            },
            "required": true,
            "name": "repostedById",
            "in": "path"
          }
        ],
        "responses": {
          "200": {
            "description": "Rows deleted",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "deleted": {
                      "type": "integer"
                    }
                  },
                  "required": ["deleted"]
                }
              }
            }
          }
        }
      }
    },
    "/internal/feed/users/{userId}/authors/{authorId}": {
      "delete": {
        "tags": ["internal"],
        "security": [
          {
            "serviceToken": []
          }
        ],
        "description": "Unfollowed: the author entries leave this one feed (fanout worker).",
        "parameters": [
          {
            "schema": {
              "type": "string",
              "format": "uuid",
              "example": "b1c2d3e4-0000-4000-8000-000000000001"
            },
            "required": true,
            "name": "userId",
            "in": "path"
          },
          {
            "schema": {
              "type": "string",
              "format": "uuid",
              "example": "b1c2d3e4-0000-4000-8000-000000000001"
            },
            "required": true,
            "name": "authorId",
            "in": "path"
          }
        ],
        "responses": {
          "200": {
            "description": "Rows deleted",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "deleted": {
                      "type": "integer"
                    }
                  },
                  "required": ["deleted"]
                }
              }
            }
          }
        }
      }
    },
    "/internal/feed/users/{userId}": {
      "delete": {
        "tags": ["internal"],
        "security": [
          {
            "serviceToken": []
          }
        ],
        "description": "Delete all feed entries for a user (reset job / fanout).",
        "parameters": [
          {
            "schema": {
              "type": "string",
              "format": "uuid",
              "example": "b1c2d3e4-0000-4000-8000-000000000001"
            },
            "required": true,
            "name": "userId",
            "in": "path"
          }
        ],
        "responses": {
          "200": {
            "description": "Rows deleted",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "deleted": {
                      "type": "integer"
                    }
                  },
                  "required": ["deleted"]
                }
              }
            }
          }
        }
      }
    },
    "/internal/reseed": {
      "post": {
        "tags": ["internal"],
        "security": [
          {
            "serviceToken": []
          }
        ],
        "description": "Truncate feed entries (reset job); the timeline rebuilds from events.",
        "responses": {
          "200": {
            "description": "Acknowledged",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "ok": {
                      "type": "boolean"
                    }
                  },
                  "required": ["ok"]
                }
              }
            }
          }
        }
      }
    },
    "/internal/reset-status": {
      "get": {
        "tags": ["internal"],
        "security": [
          {
            "serviceToken": []
          }
        ],
        "description": "Last reset/reseed run (written by the reset job to Valkey) for the admin health tile; null when no reset has run.",
        "responses": {
          "200": {
            "description": "Reset status or null",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ResetStatus"
                }
              }
            }
          }
        }
      }
    }
  }
}
