{
  "openapi": "3.0.3",
  "info": {
    "title": "xitter social API",
    "description": "Profiles, follows, and blocks.",
    "version": "v1"
  },
  "servers": [
    {
      "url": "/api/social/v1"
    }
  ],
  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT"
      },
      "serviceToken": {
        "type": "http",
        "scheme": "bearer",
        "description": "Client-credentials service token (audience = svc-social)."
      }
    },
    "schemas": {
      "Error": {
        "type": "object",
        "properties": {
          "error": {
            "type": "object",
            "properties": {
              "code": {
                "type": "string"
              },
              "message": {
                "type": "string"
              },
              "details": {
                "type": "object",
                "additionalProperties": {
                  "nullable": true
                }
              }
            },
            "required": [
              "code",
              "message"
            ]
          }
        },
        "required": [
          "error"
        ]
      },
      "CreateProfileRequest": {
        "type": "object",
        "properties": {
          "displayName": {
            "type": "string",
            "minLength": 1,
            "maxLength": 50
          },
          "bio": {
            "type": "string",
            "nullable": true,
            "maxLength": 200
          }
        },
        "additionalProperties": false
      },
      "UpdateProfileRequest": {
        "type": "object",
        "properties": {
          "displayName": {
            "type": "string",
            "minLength": 1,
            "maxLength": 50
          },
          "bio": {
            "type": "string",
            "nullable": true,
            "maxLength": 200
          }
        },
        "additionalProperties": false
      },
      "ProfilePage": {
        "type": "object",
        "properties": {
          "items": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "id": {
                  "type": "string",
                  "format": "uuid",
                  "example": "b1c2d3e4-0000-4000-8000-000000000001"
                },
                "username": {
                  "type": "string",
                  "minLength": 3,
                  "maxLength": 20,
                  "pattern": "^[a-z0-9_]+$"
                },
                "displayName": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 50
                },
                "bio": {
                  "type": "string",
                  "nullable": true,
                  "maxLength": 200
                },
                "createdAt": {
                  "type": "string",
                  "format": "date-time"
                }
              },
              "required": [
                "id",
                "username",
                "displayName",
                "bio",
                "createdAt"
              ]
            }
          },
          "nextCursor": {
            "type": "string",
            "nullable": true
          }
        },
        "required": [
          "items",
          "nextCursor"
        ]
      }
    },
    "parameters": {}
  },
  "paths": {
    "/profiles/{userId}": {
      "post": {
        "tags": [
          "profiles"
        ],
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "description": "Idempotent upsert of the caller own profile (`userId` = caller).",
        "parameters": [
          {
            "schema": {
              "type": "string",
              "format": "uuid",
              "example": "b1c2d3e4-0000-4000-8000-000000000001"
            },
            "required": true,
            "name": "userId",
            "in": "path"
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreateProfileRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Profile (existing returned unchanged on re-POST)",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "id": {
                      "type": "string",
                      "format": "uuid",
                      "example": "b1c2d3e4-0000-4000-8000-000000000001"
                    },
                    "username": {
                      "type": "string",
                      "minLength": 3,
                      "maxLength": 20,
                      "pattern": "^[a-z0-9_]+$"
                    },
                    "displayName": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 50
                    },
                    "bio": {
                      "type": "string",
                      "nullable": true,
                      "maxLength": 200
                    },
                    "createdAt": {
                      "type": "string",
                      "format": "date-time"
                    }
                  },
                  "required": [
                    "id",
                    "username",
                    "displayName",
                    "bio",
                    "createdAt"
                  ]
                }
              }
            }
          },
          "400": {
            "description": "Validation error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "403": {
            "description": "userId is not the caller",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      },
      "get": {
        "tags": [
          "profiles"
        ],
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "parameters": [
          {
            "schema": {
              "type": "string",
              "format": "uuid",
              "example": "b1c2d3e4-0000-4000-8000-000000000001"
            },
            "required": true,
            "name": "userId",
            "in": "path"
          }
        ],
        "responses": {
          "200": {
            "description": "Profile with follow counts",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "id": {
                      "type": "string",
                      "format": "uuid",
                      "example": "b1c2d3e4-0000-4000-8000-000000000001"
                    },
                    "username": {
                      "type": "string",
                      "minLength": 3,
                      "maxLength": 20,
                      "pattern": "^[a-z0-9_]+$"
                    },
                    "displayName": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 50
                    },
                    "bio": {
                      "type": "string",
                      "nullable": true,
                      "maxLength": 200
                    },
                    "createdAt": {
                      "type": "string",
                      "format": "date-time"
                    },
                    "counts": {
                      "type": "object",
                      "properties": {
                        "following": {
                          "type": "integer",
                          "minimum": 0
                        },
                        "followers": {
                          "type": "integer",
                          "minimum": 0
                        }
                      },
                      "required": [
                        "following",
                        "followers"
                      ]
                    }
                  },
                  "required": [
                    "id",
                    "username",
                    "displayName",
                    "bio",
                    "createdAt",
                    "counts"
                  ]
                }
              }
            }
          },
          "404": {
            "description": "Not found",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      },
      "patch": {
        "tags": [
          "profiles"
        ],
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "description": "Partial update, own profile only.",
        "parameters": [
          {
            "schema": {
              "type": "string",
              "format": "uuid",
              "example": "b1c2d3e4-0000-4000-8000-000000000001"
            },
            "required": true,
            "name": "userId",
            "in": "path"
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/UpdateProfileRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Updated profile",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "id": {
                      "type": "string",
                      "format": "uuid",
                      "example": "b1c2d3e4-0000-4000-8000-000000000001"
                    },
                    "username": {
                      "type": "string",
                      "minLength": 3,
                      "maxLength": 20,
                      "pattern": "^[a-z0-9_]+$"
                    },
                    "displayName": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 50
                    },
                    "bio": {
                      "type": "string",
                      "nullable": true,
                      "maxLength": 200
                    },
                    "createdAt": {
                      "type": "string",
                      "format": "date-time"
                    }
                  },
                  "required": [
                    "id",
                    "username",
                    "displayName",
                    "bio",
                    "createdAt"
                  ]
                }
              }
            }
          },
          "403": {
            "description": "Not your profile",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "404": {
            "description": "Not found",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
