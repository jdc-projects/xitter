    "/internal/reseed": {
      "post": {
        "tags": [
          "internal"
        ],
        "security": [
          {
            "serviceToken": []
          }
        ],
        "description": "Truncate profiles + graph (reset job); deterministic reseed runs via the seed script.",
        "responses": {
          "200": {
            "description": "Acknowledged",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
