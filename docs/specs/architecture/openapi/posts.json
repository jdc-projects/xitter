                                "format": "uuid",
                                "example": "b1c2d3e4-0000-4000-8000-000000000002"
                              },
                              "counts": {
                                "type": "object",
                                "properties": {
                                  "replies": {
                                    "type": "integer",
                                    "minimum": 0
                                  },
                                  "likes": {
                                    "type": "integer",
                                    "minimum": 0
                                  },
                                  "reposts": {
                                    "type": "integer",
                                    "minimum": 0
                                  }
                                },
                                "required": ["replies", "likes", "reposts"]
                              },
                              "createdAt": {
                                "type": "string",
                                "format": "date-time"
                              },
                              "deletedAt": {
                                "type": "string",
                                "nullable": true,
                                "format": "date-time"
                              }
                            },
                            "required": [
                              "id",
                              "authorId",
                              "text",
                              "media",
