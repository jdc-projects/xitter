                                      "type": "array",
                                      "items": {
                                        "type": "object",
                                        "properties": {
                                          "kind": {
                                            "type": "string",
                                            "enum": ["original", "thumb"]
                                          },
                                          "objectKey": {
                                            "type": "string",
                                            "minLength": 1
                                          },
                                          "mimeType": {
