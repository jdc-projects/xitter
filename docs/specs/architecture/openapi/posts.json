{
  "openapi": "3.0.3",
  "info": {
    "title": "xitter posts API",
    "description": "Posts, replies, and interactions (likes, bookmarks, reposts).",
    "version": "v1"
  },
  "servers": [
    {
      "url": "/api/posts/v1"
    }
  ],
  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT"
      },
      "serviceToken": {
        "type": "http",
        "scheme": "bearer",
        "description": "Client-credentials service token (audience = svc-posts)."
      }
    },
    "schemas": {
      "Error": {
        "type": "object",
        "properties": {
          "error": {
            "type": "object",
            "properties": {
              "code": {
                "type": "string"
              },
              "message": {
                "type": "string"
              },
              "details": {
                "type": "object",
                "additionalProperties": {
                  "nullable": true
                }
              }
            },
            "required": ["code", "message"]
          }
        },
        "required": ["error"]
      },
      "CreatePostRequest": {
        "type": "object",
        "properties": {
          "text": {
            "type": "string",
            "minLength": 1,
            "maxLength": 512
          },
          "mediaIds": {
            "type": "array",
            "items": {
              "type": "string",
              "format": "uuid"
            },
            "maxItems": 4,
            "default": []
          },
          "replyToId": {
            "type": "string",
            "nullable": true,
            "format": "uuid",
            "default": null,
            "example": "b1c2d3e4-0000-4000-8000-000000000002"
          }
        },
        "required": ["text"],
        "additionalProperties": false
      }
    },
    "parameters": {}
  },
  "paths": {
    "/posts": {
      "post": {
        "tags": ["posts"],
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "description": "Create a post or reply. `text` is 1-512 chars; `mediaIds` (max 4) must exist, belong to the author and be ready (media internal lookup; non-ready ids 400 with details). Replies are rejected when a block exists between the replier and the parent author in either direction.",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreatePostRequest"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Created post",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "id": {
                      "type": "string",
                      "format": "uuid",
                      "example": "b1c2d3e4-0000-4000-8000-000000000002"
                    },
                    "authorId": {
                      "type": "string",
                      "format": "uuid",
                      "example": "b1c2d3e4-0000-4000-8000-000000000001"
                    },
                    "text": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 512
                    },
                    "media": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "properties": {
                          "id": {
                            "type": "string",
                            "format": "uuid"
                          },
                          "ownerId": {
                            "type": "string",
                            "format": "uuid",
                            "example": "b1c2d3e4-0000-4000-8000-000000000001"
                          },
                          "status": {
                            "type": "string",
                            "enum": ["pending", "ready", "failed"]
                          },
                          "variants": {
                            "type": "array",
                            "items": {
                              "type": "object",
                              "properties": {
                                "kind": {
                                  "type": "string",
                                  "enum": ["original", "thumb"]
                                },
                                "objectKey": {
                                  "type": "string",
                                  "minLength": 1
                                },
                                "mimeType": {
                                  "type": "string",
                                  "minLength": 1
                                },
                                "bytes": {
                                  "type": "integer",
                                  "minimum": 0,
                                  "exclusiveMinimum": true
                                },
                                "width": {
                                  "type": "integer",
                                  "nullable": true,
                                  "minimum": 0,
                                  "exclusiveMinimum": true
                                },
                                "height": {
                                  "type": "integer",
                                  "nullable": true,
                                  "minimum": 0,
                                  "exclusiveMinimum": true
                                },
                                "url": {
                                  "type": "string",
                                  "minLength": 1
                                }
                              },
                              "required": [
                                "kind",
                                "objectKey",
                                "mimeType",
                                "bytes",
                                "width",
                                "height",
                                "url"
                              ]
                            }
                          },
                          "createdAt": {
                            "type": "string",
                            "format": "date-time"
                          }
                        },
                        "required": ["id", "ownerId", "status", "variants", "createdAt"]
                      }
                    },
                    "replyToId": {
                      "type": "string",
                      "nullable": true,
                      "format": "uuid",
                      "example": "b1c2d3e4-0000-4000-8000-000000000002"
                    },
                    "repostOfId": {
                      "type": "string",
                      "nullable": true,
                      "format": "uuid",
                      "example": "b1c2d3e4-0000-4000-8000-000000000002"
                    },
                    "counts": {
                      "type": "object",
                      "properties": {
                        "replies": {
                          "type": "integer",
                          "minimum": 0
                        },
                        "likes": {
                          "type": "integer",
                          "minimum": 0
                        },
                        "reposts": {
                          "type": "integer",
                          "minimum": 0
                        }
                      },
                      "required": ["replies", "likes", "reposts"]
                    },
                    "createdAt": {
                      "type": "string",
                      "format": "date-time"
                    },
                    "deletedAt": {
                      "type": "string",
                      "nullable": true,
                      "format": "date-time"
                    }
                  },
                  "required": [
                    "id",
                    "authorId",
                    "text",
                    "media",
                    "replyToId",
                    "repostOfId",
                    "counts",
                    "createdAt",
                    "deletedAt"
                  ]
                }
              }
            }
          },
          "400": {
            "description": "Validation error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "403": {
            "description": "Blocked from replying",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "404": {
            "description": "Reply target not found",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
