                    }
                  },
                  "required": [
                    "id",
                    "ownerId",
                    "status",
                    "variants",
                    "createdAt",
                    "objectKey",
                    "mimeType",
                    "bytes",
                    "attempts"
                  ]
                }
              }
            }
          },
          "404": {
            "description": "Not found",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/internal/media/{mediaId}/failure": {
      "post": {
        "tags": ["internal"],
        "security": [
          {
            "serviceToken": []
          }
