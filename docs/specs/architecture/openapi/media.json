{
  "openapi": "3.0.3",
  "info": {
    "title": "xitter media API",
    "description": "Image uploads: pre-signed URLs, metadata, RustFS-backed storage.",
    "version": "v1"
  },
  "servers": [
    {
      "url": "/api/media/v1"
    }
  ],
  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT"
      },
      "serviceToken": {
        "type": "http",
        "scheme": "bearer",
        "description": "Client-credentials service token (audience = svc-media)."
      },
      "adminToken": {
        "type": "http",
        "scheme": "bearer",
        "description": "Admin principal: an admin-realm user token (admin-panel client, ADMIN_ROLES realm role) or a svc-admin service token carrying an admin role."
      }
    },
    "schemas": {
      "CreateMediaUploadResponse": {
        "type": "object",
        "properties": {
          "mediaId": {
            "type": "string",
            "format": "uuid"
          },
          "uploadUrl": {
            "type": "string",
            "format": "uri"
          }
        },
        "required": ["mediaId", "uploadUrl"]
      },
      "Error": {
        "type": "object",
        "properties": {
          "error": {
            "type": "object",
            "properties": {
              "code": {
                "type": "string"
              },
              "message": {
                "type": "string"
              },
              "details": {
                "type": "object",
                "additionalProperties": {
                  "nullable": true
                }
              }
            },
            "required": ["code", "message"]
          }
        },
        "required": ["error"]
      },
      "CreateMediaUploadRequest": {
        "type": "object",
        "properties": {
          "mimeType": {
            "type": "string",
            "minLength": 1
          },
          "bytes": {
            "type": "integer",
            "minimum": 0,
            "exclusiveMinimum": true
          }
        },
        "required": ["mimeType", "bytes"],
        "additionalProperties": false
      },
      "RecordVariantsRequest": {
        "type": "object",
        "properties": {
          "variants": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "kind": {
                  "type": "string",
                  "enum": ["original", "thumb"]
                },
                "objectKey": {
                  "type": "string",
                  "minLength": 1
                },
                "mimeType": {
                  "type": "string",
                  "minLength": 1
                },
                "bytes": {
                  "type": "integer",
                  "minimum": 0,
                  "exclusiveMinimum": true
                },
                "width": {
                  "type": "integer",
                  "nullable": true,
                  "minimum": 0,
                  "exclusiveMinimum": true
                },
                "height": {
                  "type": "integer",
                  "nullable": true,
                  "minimum": 0,
                  "exclusiveMinimum": true
                }
              },
              "required": ["kind", "objectKey", "mimeType", "bytes", "width", "height"]
            }
          }
        },
        "required": ["variants"],
        "additionalProperties": false
      },
      "AdminMediaPage": {
        "type": "object",
        "properties": {
          "items": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "id": {
                  "type": "string",
                  "format": "uuid"
                },
                "ownerId": {
                  "type": "string",
                  "format": "uuid",
                  "example": "b1c2d3e4-0000-4000-8000-000000000001"
                },
                "status": {
                  "type": "string",
                  "enum": ["pending", "ready", "failed"]
                },
                "variants": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "properties": {
                      "kind": {
                        "type": "string",
                        "enum": ["original", "thumb"]
                      },
                      "objectKey": {
                        "type": "string",
                        "minLength": 1
                      },
                      "mimeType": {
                        "type": "string",
                        "minLength": 1
                      },
                      "bytes": {
                        "type": "integer",
                        "minimum": 0,
                        "exclusiveMinimum": true
                      },
                      "width": {
                        "type": "integer",
                        "nullable": true,
                        "minimum": 0,
                        "exclusiveMinimum": true
                      },
                      "height": {
                        "type": "integer",
                        "nullable": true,
                        "minimum": 0,
                        "exclusiveMinimum": true
                      },
                      "url": {
                        "type": "string",
                        "minLength": 1
                      }
                    },
                    "required": ["kind", "objectKey", "mimeType", "bytes", "width", "height", "url"]
                  }
                },
                "altText": {
                  "type": "string",
                  "nullable": true,
                  "maxLength": 200
                },
                "createdAt": {
                  "type": "string",
                  "format": "date-time"
                },
                "objectKey": {
                  "type": "string",
                  "minLength": 1
                },
                "mimeType": {
                  "type": "string",
                  "minLength": 1
                },
                "bytes": {
                  "type": "integer",
                  "minimum": 0,
                  "exclusiveMinimum": true
                },
                "attempts": {
                  "type": "integer",
                  "minimum": 0
                }
              },
              "required": [
                "id",
                "ownerId",
                "status",
                "variants",
                "createdAt",
                "objectKey",
                "mimeType",
                "bytes",
                "attempts"
              ]
            }
          },
          "nextCursor": {
            "type": "string",
            "nullable": true
          }
        },
        "required": ["items", "nextCursor"]
      },
      "AdminAuditPage": {
        "type": "object",
        "properties": {
          "items": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/AdminAuditEntry"
            }
          },
          "nextCursor": {
            "type": "string",
            "nullable": true
          }
        },
        "required": ["items", "nextCursor"]
      },
      "AdminAuditEntry": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "actorId": {
            "type": "string",
            "minLength": 1
          },
          "actorName": {
            "type": "string",
            "minLength": 1
          },
          "action": {
            "type": "string",
            "enum": ["post.soft-delete", "post.hard-delete", "post.restore", "media.delete"]
          },
          "targetId": {
            "type": "string",
            "minLength": 1
          },
          "detail": {
            "type": "object",
            "nullable": true,
            "additionalProperties": {
              "nullable": true
            }
          },
          "createdAt": {
            "type": "string",
            "format": "date-time"
          }
        },
        "required": ["id", "actorId", "actorName", "action", "targetId", "detail", "createdAt"]
      }
    },
    "parameters": {}
  },
  "paths": {
    "/uploads": {
      "post": {
        "tags": ["media"],
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "description": "Create an upload slot for one image. The mime allowlist (png/jpeg/webp/gif, 415) and the 5MB cap (413) are enforced here; the response carries a presigned PUT URL for RustFS (15 min - SigV4 binds the host only, so the stored content type is re-checked at completion).",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreateMediaUploadRequest"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Upload slot created; PUT bytes to uploadUrl",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CreateMediaUploadResponse"
                }
              }
            }
          },
          "400": {
            "description": "Validation error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "413": {
            "description": "Over the 5MB cap",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "415": {
            "description": "Unsupported image type",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/media/{mediaId}/complete": {
      "post": {
        "tags": ["media"],
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "description": "Confirm the browser PUT finished. The service HEADs the exact object key server-side (and re-checks the real size) before emitting `media.media.uploaded`; a client-asserted success is never trusted. Idempotent - a repeated complete does not re-emit.",
        "parameters": [
          {
            "schema": {
              "type": "string",
              "format": "uuid"
            },
            "required": true,
            "name": "mediaId",
            "in": "path"
          }
        ],
        "responses": {
          "200": {
            "description": "Asset (status pending until the worker records variants)",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "id": {
                      "type": "string",
                      "format": "uuid"
                    },
                    "ownerId": {
                      "type": "string",
                      "format": "uuid",
                      "example": "b1c2d3e4-0000-4000-8000-000000000001"
                    },
                    "status": {
                      "type": "string",
                      "enum": ["pending", "ready", "failed"]
                    },
                    "variants": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "properties": {
                          "kind": {
                            "type": "string",
                            "enum": ["original", "thumb"]
                          },
                          "objectKey": {
                            "type": "string",
                            "minLength": 1
                          },
                          "mimeType": {
                            "type": "string",
                            "minLength": 1
                          },
                          "bytes": {
                            "type": "integer",
                            "minimum": 0,
                            "exclusiveMinimum": true
                          },
                          "width": {
                            "type": "integer",
                            "nullable": true,
                            "minimum": 0,
                            "exclusiveMinimum": true
                          },
                          "height": {
                            "type": "integer",
                            "nullable": true,
                            "minimum": 0,
                            "exclusiveMinimum": true
                          },
                          "url": {
                            "type": "string",
                            "minLength": 1
                          }
                        },
                        "required": [
                          "kind",
                          "objectKey",
                          "mimeType",
                          "bytes",
                          "width",
                          "height",
                          "url"
                        ]
                      }
                    },
                    "altText": {
                      "type": "string",
                      "nullable": true,
                      "maxLength": 200
                    },
                    "createdAt": {
                      "type": "string",
                      "format": "date-time"
                    }
                  },
                  "required": ["id", "ownerId", "status", "variants", "createdAt"]
                }
              }
            }
          },
          "400": {
            "description": "Object missing / still uploading, or failed processing",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "404": {
            "description": "Not found (or not yours)",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/media/{mediaId}": {
      "get": {
        "tags": ["media"],
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "description": "Media metadata incl. variant URLs (`original`, `thumb`) under `/media`.",
        "parameters": [
          {
            "schema": {
              "type": "string",
              "format": "uuid"
            },
            "required": true,
            "name": "mediaId",
            "in": "path"
          }
        ],
        "responses": {
          "200": {
            "description": "Media asset",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "id": {
                      "type": "string",
                      "format": "uuid"
                    },
                    "ownerId": {
                      "type": "string",
                      "format": "uuid",
                      "example": "b1c2d3e4-0000-4000-8000-000000000001"
                    },
                    "status": {
                      "type": "string",
                      "enum": ["pending", "ready", "failed"]
                    },
                    "variants": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "properties": {
                          "kind": {
                            "type": "string",
                            "enum": ["original", "thumb"]
                          },
                          "objectKey": {
                            "type": "string",
                            "minLength": 1
                          },
                          "mimeType": {
                            "type": "string",
                            "minLength": 1
                          },
                          "bytes": {
                            "type": "integer",
                            "minimum": 0,
                            "exclusiveMinimum": true
                          },
                          "width": {
                            "type": "integer",
                            "nullable": true,
                            "minimum": 0,
                            "exclusiveMinimum": true
                          },
                          "height": {
                            "type": "integer",
                            "nullable": true,
                            "minimum": 0,
                            "exclusiveMinimum": true
                          },
                          "url": {
                            "type": "string",
                            "minLength": 1
                          }
                        },
                        "required": [
                          "kind",
                          "objectKey",
                          "mimeType",
                          "bytes",
                          "width",
                          "height",
                          "url"
                        ]
                      }
                    },
                    "altText": {
                      "type": "string",
                      "nullable": true,
                      "maxLength": 200
                    },
                    "createdAt": {
                      "type": "string",
                      "format": "date-time"
                    }
                  },
                  "required": ["id", "ownerId", "status", "variants", "createdAt"]
                }
              }
            }
          },
          "404": {
            "description": "Not found",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/internal/media/lookup": {
      "post": {
        "tags": ["internal"],
        "security": [
          {
            "serviceToken": []
          }
        ],
        "description": "Resolve assets for post attachment: returns the assets among mediaIds that exist AND are owned by ownerId. Callers (posts) enforce ready-status on the response.",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "ownerId": {
                    "type": "string",
                    "format": "uuid",
                    "example": "b1c2d3e4-0000-4000-8000-000000000001"
                  },
                  "mediaIds": {
                    "type": "array",
                    "items": {
                      "type": "string",
                      "format": "uuid"
                    },
                    "minItems": 1,
                    "maxItems": 4
                  },
                  "altTexts": {
                    "type": "object",
                    "additionalProperties": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 200
                    }
                  }
                },
                "required": ["ownerId", "mediaIds"],
                "additionalProperties": false
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Owned assets (possibly fewer than requested)",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "items": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "properties": {
                          "id": {
                            "type": "string",
                            "format": "uuid"
                          },
                          "ownerId": {
                            "type": "string",
                            "format": "uuid",
                            "example": "b1c2d3e4-0000-4000-8000-000000000001"
                          },
                          "status": {
                            "type": "string",
                            "enum": ["pending", "ready", "failed"]
                          },
                          "variants": {
                            "type": "array",
                            "items": {
                              "type": "object",
                              "properties": {
                                "kind": {
                                  "type": "string",
                                  "enum": ["original", "thumb"]
                                },
                                "objectKey": {
                                  "type": "string",
                                  "minLength": 1
                                },
                                "mimeType": {
                                  "type": "string",
                                  "minLength": 1
                                },
                                "bytes": {
                                  "type": "integer",
                                  "minimum": 0,
                                  "exclusiveMinimum": true
                                },
                                "width": {
                                  "type": "integer",
                                  "nullable": true,
                                  "minimum": 0,
                                  "exclusiveMinimum": true
                                },
                                "height": {
                                  "type": "integer",
                                  "nullable": true,
                                  "minimum": 0,
                                  "exclusiveMinimum": true
                                },
                                "url": {
                                  "type": "string",
                                  "minLength": 1
                                }
                              },
                              "required": [
                                "kind",
                                "objectKey",
                                "mimeType",
                                "bytes",
                                "width",
                                "height",
                                "url"
                              ]
                            }
                          },
                          "altText": {
                            "type": "string",
                            "nullable": true,
                            "maxLength": 200
                          },
                          "createdAt": {
                            "type": "string",
                            "format": "date-time"
                          }
                        },
                        "required": ["id", "ownerId", "status", "variants", "createdAt"]
                      }
                    }
                  },
                  "required": ["items"]
                }
              }
            }
          }
        }
      }
    },
    "/internal/media/{mediaId}/variants": {
      "post": {
        "tags": ["internal"],
        "security": [
          {
            "serviceToken": []
          }
        ],
        "description": "media-process worker: record processed variants and flip the asset to ready (emits `media.media.processed`). Idempotent on redelivery.",
        "parameters": [
          {
            "schema": {
              "type": "string",
              "format": "uuid"
            },
            "required": true,
            "name": "mediaId",
            "in": "path"
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/RecordVariantsRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Updated asset",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "id": {
                      "type": "string",
                      "format": "uuid"
                    },
                    "ownerId": {
                      "type": "string",
                      "format": "uuid",
                      "example": "b1c2d3e4-0000-4000-8000-000000000001"
                    },
                    "status": {
                      "type": "string",
                      "enum": ["pending", "ready", "failed"]
                    },
                    "variants": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "properties": {
                          "kind": {
                            "type": "string",
                            "enum": ["original", "thumb"]
                          },
                          "objectKey": {
                            "type": "string",
                            "minLength": 1
                          },
                          "mimeType": {
                            "type": "string",
                            "minLength": 1
                          },
                          "bytes": {
                            "type": "integer",
                            "minimum": 0,
                            "exclusiveMinimum": true
                          },
                          "width": {
                            "type": "integer",
                            "nullable": true,
                            "minimum": 0,
                            "exclusiveMinimum": true
                          },
                          "height": {
                            "type": "integer",
                            "nullable": true,
                            "minimum": 0,
                            "exclusiveMinimum": true
                          },
                          "url": {
                            "type": "string",
                            "minLength": 1
                          }
                        },
                        "required": [
                          "kind",
                          "objectKey",
                          "mimeType",
                          "bytes",
                          "width",
                          "height",
                          "url"
                        ]
                      }
                    },
                    "altText": {
                      "type": "string",
                      "nullable": true,
                      "maxLength": 200
                    },
                    "createdAt": {
                      "type": "string",
                      "format": "date-time"
                    }
                  },
                  "required": ["id", "ownerId", "status", "variants", "createdAt"]
                }
              }
            }
          },
          "404": {
            "description": "Not found",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
