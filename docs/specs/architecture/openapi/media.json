        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "error": {
                    "type": "string",
                    "minLength": 1
                  }
                },
                "required": ["error"]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Asset (pending until the cap, then failed)",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "id": {
                      "type": "string",
                      "format": "uuid"
                    },
                    "ownerId": {
                      "type": "string",
                      "format": "uuid",
                      "example": "b1c2d3e4-0000-4000-8000-000000000001"
                    },
                    "status": {
                      "type": "string",
                      "enum": ["pending", "ready", "failed"]
                    },
                    "variants": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "properties": {
                          "kind": {
                            "type": "string",
                            "enum": ["original", "thumb"]
                          },
                          "objectKey": {
                            "type": "string",
                            "minLength": 1
                          },
                          "mimeType": {
                            "type": "string",
                            "minLength": 1
                          },
                          "bytes": {
                            "type": "integer",
                            "minimum": 0,
                            "exclusiveMinimum": true
                          },
                          "width": {
                            "type": "integer",
                            "nullable": true,
                            "minimum": 0,
                            "exclusiveMinimum": true
                          },
                          "height": {
                            "type": "integer",
                            "nullable": true,
                            "minimum": 0,
                            "exclusiveMinimum": true
                          },
                          "url": {
                            "type": "string",
                            "minLength": 1
                          }
                        },
                        "required": [
                          "kind",
                          "objectKey",
                          "mimeType",
                          "bytes",
                          "width",
                          "height",
                          "url"
                        ]
                      }
                    },
                    "altText": {
                      "type": "string",
                      "nullable": true,
                      "maxLength": 200
                    },
                    "createdAt": {
                      "type": "string",
                      "format": "date-time"
                    }
                  },
                  "required": ["id", "ownerId", "status", "variants", "createdAt"]
                }
              }
            }
          },
          "404": {
            "description": "Not found",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
