      },
      "targets": [
        {
          "datasource": { "type": "prometheus" },
          "expr": "xitter_kafka_consumer_lag",
          "legendFormat": "{{topic}}[{{partition}}]",
          "refId": "A"
        }
      ],
      "title": "Lag per topic × partition",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus" },
      "fieldConfig": {
