{
  "annotations": { "list": [] },
  "editable": true,
  "fiscalYearStartMonth": 0,
  "refresh": "30s",
  "schemaVersion": 39,
  "tags": ["xitter"],
  "time": { "from": "now-6h", "to": "now" },
  "timezone": "browser",
  "title": "xitter · Feed freshness / lag",
  "uid": "xitter-feed-freshness",
  "version": 1,
  "panels": [
    {
      "datasource": { "type": "prometheus" },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "orange", "value": 300 },
              { "color": "red", "value": 900 }
            ]
          }
        },
        "overrides": []
      },
      "gridPos": { "h": 6, "w": 8, "x": 0, "y": 0 },
      "id": 1,
      "options": {
        "colorMode": "background",
        "graphMode": "area",
        "justifyMode": "auto",
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "textMode": "auto"
      },
      "targets": [
        {
          "datasource": { "type": "prometheus" },
          "expr": "xitter_feed_newest_entry_age_seconds",
          "legendFormat": "newest entry age",
          "refId": "A"
        }
      ],
      "title": "Newest feed entry age",
      "type": "stat"
    },
    {
      "datasource": { "type": "prometheus" },
      "fieldConfig": {
        "defaults": { "unit": "s", "custom": { "fillOpacity": 10, "lineWidth": 1 } },
        "overrides": []
      },
      "gridPos": { "h": 6, "w": 16, "x": 8, "y": 0 },
      "id": 2,
      "options": {
        "legend": {
          "calcs": ["mean", "max"],
          "displayMode": "table",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": { "mode": "multi", "sort": "desc" }
      },
      "targets": [
        {
          "datasource": { "type": "prometheus" },
          "expr": "xitter_feed_newest_entry_age_seconds",
          "legendFormat": "newest entry age",
          "refId": "A"
        }
      ],
      "title": "Feed freshness over time (time-to-feed SLO input)",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus" },
      "fieldConfig": {
        "defaults": { "unit": "short", "custom": { "fillOpacity": 20, "lineWidth": 1 } },
        "overrides": []
      },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 6 },
      "id": 3,
      "options": {
        "legend": {
          "calcs": ["max"],
          "displayMode": "table",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": { "mode": "multi", "sort": "desc" }
      },
      "targets": [
        {
          "datasource": { "type": "prometheus" },
          "expr": "sum by (topic) (xitter_kafka_consumer_lag)",
          "legendFormat": "{{topic}}",
          "refId": "A"
        }
      ],
      "title": "Fanout worker backlog (consumer lag by topic)",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus" },
      "fieldConfig": {
        "defaults": { "unit": "short", "custom": { "fillOpacity": 10, "lineWidth": 1 } },
        "overrides": []
      },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 6 },
      "id": 4,
      "options": {
        "legend": {
          "calcs": ["max"],
          "displayMode": "table",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": { "mode": "multi", "sort": "desc" }
      },
      "targets": [
        {
          "datasource": { "type": "prometheus" },
          "expr": "sum by (instance) (xitter_kafka_consumer_lag)",
          "legendFormat": "{{instance}}",
          "refId": "A"
        }
      ],
      "title": "Backlog per worker instance",
      "type": "timeseries"
    }
  ]
}
