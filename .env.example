# Copy to .env and adjust. All values are local-development defaults; nothing here is secret.
# See packages/scripts/src/env.ts for the authoritative default set and docs/specs/operations for usage.

# Isolation: unique per environment copy (worktrees, parallel runs). Used for compose project
# name, container names, volumes, Kafka client ids, and (with the offset) ports.
XITTER_ENV=local

# Added to every local port to allow parallel environment copies. Leave the
# XITTER_*_PORT vars below commented out unless you want to PIN one absolutely
# (pinned values ignore the offset).
XITTER_PORT_OFFSET=0

# Ports (defaults, offset applies - uncomment to pin):
# XITTER_EDGE_PORT=8080
# XITTER_WEB_PORT=3456
# XITTER_CMS_PORT=3457
# XITTER_ADMIN_PORT=3458
# XITTER_SOCIAL_PORT=8101
# XITTER_POSTS_PORT=8102
# XITTER_MEDIA_PORT=8103
# XITTER_FEED_PORT=8104
# XITTER_SEARCH_PORT=8105
# XITTER_POSTGRES_PORT=5532
# XITTER_KAFKA_PORT=9092
# XITTER_OPENSEARCH_PORT=9200
# XITTER_RUSTFS_PORT=9000
# XITTER_VALKEY_PORT=6379
# XITTER_KEYCLOAK_PORT=8090
# Worker metrics ports (offset applies)
# XITTER_FANOUT_METRICS_PORT=9101
# XITTER_MEDIA_PROCESS_METRICS_PORT=9102
# XITTER_SEARCH_INDEX_METRICS_PORT=9103

# Postgres (local instance superuser)
XITTER_POSTGRES_PASSWORD=xitter-local

# Keycloak (local instance; the deployed environments use the homelab Keycloak)
XITTER_KEYCLOAK_ADMIN_USER=admin
XITTER_KEYCLOAK_ADMIN_PASSWORD=admin
# Realm for demo users (reset nightly in deployed environments)
XITTER_DEMO_REALM=xitter-demo
# Realm used locally to emulate the homelab "primary" realm for admin/CMS login
XITTER_ADMIN_REALM=xitter-local-admin
# Demo account credentials - fixed, reset alongside the data reset
XITTER_DEMO_USER_PREFIX=demo
XITTER_DEMO_USER_COUNT=10
XITTER_DEMO_USER_PASSWORD=DemoPass123!

# Admin tooling (T10): the svc-admin machine client (demo realm) whose service
# account carries the system-admin role - the non-browser principal for the
# services' internal admin endpoints (bruno, scripts). Services also read
# ADMIN_REALM (see packages/config service-env) to verify panel user tokens.
# XITTER_ADMIN_CLIENT_SECRET=svc-admin-local-secret

# Seeding (defaults resolve via localPort - offset-aware; uncomment to pin
# e.g. when targeting a deployed environment)
# XITTER_SEED_BASE_URL=http://localhost:8080
# XITTER_SEED_KEYCLOAK_URL=http://localhost:8090

# CMS site content (web SSR fetch, live preview, promotion scripts). Defaults
# resolve via local ports; deployed envs override with in-cluster URLs.
# XITTER_CMS_URL=http://localhost:3457
# XITTER_CMS_PUBLIC_URL=http://localhost:8080
# XITTER_CMS_CLIENT_ID=cms
# XITTER_CMS_CLIENT_SECRET=cms-local-secret

# Cap.js captcha (keys are secret - .env only, never .env.example; same values
# as the XITTER_CAP_* repo secrets, see docs/runbooks/04-ci-and-secrets.md).
# Offset copies: keep disabled or add the offset origin to the Cap site (CORS
# is exact-match) - the default origin below assumes the default edge port.
# All four vars are required when enabled (the web app fails fast otherwise);
# the URLs below are documentation only - code has no hardcoded fallback.
XITTER_CAP_ENABLED=false
XITTER_CAP_SITE_URL=https://cap.jd-chapman.dev
XITTER_CAP_VERIFY_URL=https://cap.jd-chapman.dev
# XITTER_CAP_SITE_KEY=
# XITTER_CAP_SECRET_KEY=

# Optional per-service URL overrides for @xitter/api-client (defaults resolve
# from the local port config above; set these when targeting a deployed env)
# XITTER_SOCIAL_URL=
# XITTER_POSTS_URL=
# XITTER_MEDIA_URL=
# XITTER_FEED_URL=
# XITTER_SEARCH_URL=
# XITTER_KEYCLOAK_URL=

# Web (BFF) auth - defaults resolve from the local ports; override when the
# public origin differs (deployed envs).
# XITTER_WEB_BASE_URL=
# Valkey for web sessions and service rate limiting (defaults to
# redis://localhost:{XITTER_VALKEY_PORT}).
# XITTER_VALKEY_URL=

# RustFS (S3) for the media service + media-process worker. Defaults match
# the compose stack (non-secret local creds); deployed envs set the
# in-cluster endpoint + edge host for presigning.
# XITTER_MEDIA_S3_ENDPOINT=http://localhost:9000
# XITTER_MEDIA_S3_PUBLIC_ENDPOINT=http://localhost:9000
# XITTER_MEDIA_S3_BUCKET=xitter-media
# XITTER_MEDIA_S3_ACCESS_KEY=xitter-local
# XITTER_MEDIA_S3_SECRET_KEY=xitter-local-secret

# OpenSearch for the search service + local bootstrap + search-index
# worker tests. Default resolves from XITTER_OPENSEARCH_PORT; deployed envs
# override with the in-cluster URL.
# XITTER_OPENSEARCH_URL=http://localhost:9200
